# Production config for docker-compose.prod.yml.
#   cp .env.example .env && chmod 600 .env     (on the server; never commit .env)

# Alpaca Market Data credentials (https://app.alpaca.markets -> API keys).
KEY_ID=
SECRET=

# Leave empty to serve plain HTTP on the instance's IP (port 80).
# Set to a hostname whose DNS points at this box, with ports 80 + 443 open,
# and Caddy obtains a Let's Encrypt certificate automatically.
DOMAIN=mariosmoneymakers.duckdns.org

# Browser origins allowed to call the API. Irrelevant when the page and the
# API share the origin via Caddy (the default); set if you host them apart.
ALLOWED_ORIGINS=http://localhost
